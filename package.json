{
  "name": "herdr-island",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "description": "Windows Dynamic Island read-only monitor for Herdr agents (Codex, Devin, AGY) and quotas",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.42.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.5"
  }
}
